{
  "name": "dsh-message-metrics",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "description": "A gauge action under each assistant reply that opens the message's performance dashboard: model, prompt and cached tokens, TTFT, prefill and decode throughput, and total time.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "LICENSE",
    "docs/*.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "performance",
    "tokens",
    "metrics"
  ],
  "author": {
    "name": "LI",
    "url": "https://github.com/LXD-8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LXD-8/dsh-message-metrics.git"
  }
}
